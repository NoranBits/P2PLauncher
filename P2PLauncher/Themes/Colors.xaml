<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Base palette -->
  <Color x:Key="PrimaryColor">#FF2D7D9A</Color>
  <Color x:Key="PrimaryColorDark">#FF1E556B</Color>
  <Color x:Key="AccentColor">#FF35C2A1</Color>

  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryColorDark}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

  <!-- Spacing tokens -->
  <Thickness x:Key="SpaceXS">4</Thickness>
  <Thickness x:Key="SpaceS">8</Thickness>
  <Thickness x:Key="SpaceM">12</Thickness>
  <Thickness x:Key="SpaceL">16</Thickness>
</ResourceDictionary>
