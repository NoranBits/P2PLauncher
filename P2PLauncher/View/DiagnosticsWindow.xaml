<Window x:Class="P2PLauncher.View.DiagnosticsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics" Height="240" Width="480">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Label Content="Host:" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBoxHost" Width="250" Margin="6,0,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8">
            <Label Content="Port:" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBoxPort" Width="80" Margin="6,0,0,0">12000</TextBox>
        </StackPanel>

        <TextBox x:Name="TextBoxResults" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Test" Width="80" Margin="0,0,8,0" Click="OnTestClick"/>
            <Button Content="Close" Width="80" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
