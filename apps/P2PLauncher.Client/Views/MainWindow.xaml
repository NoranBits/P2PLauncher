<Window x:Class="P2PLauncher.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="P2P Launcher - Client" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <TabControl Margin="10">
            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard" x:Name="DashboardTab" DataContext="{Binding Dashboard}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Connection Status -->
                    <GroupBox Header="Connection Status" Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <TextBlock Text="{Binding ConnectionState, StringFormat='Status: {0}'}" 
                                       FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding PeerCount, StringFormat='Connected Peers: {0}'}" 
                                       FontSize="12"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Control Buttons -->
                    <GroupBox Header="Connection Controls" Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                            <Button Content="Start Host" 
                                    Command="{Binding StartHostCommand}" 
                                    Width="100" Height="35" Margin="0,0,10,0"/>
                            <Button Content="Connect" 
                                    Command="{Binding ConnectCommand}" 
                                    Width="100" Height="35" Margin="0,0,10,0"/>
                            <Button Content="Disconnect" 
                                    Command="{Binding DisconnectCommand}" 
                                    Width="100" Height="35"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Recent Activity -->
                    <GroupBox Header="Recent Activity" Grid.Row="2" Margin="0,0,0,10">
                        <ListBox ItemsSource="{Binding RecentLogLines}" 
                                 Height="200" 
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" 
                                 FontSize="11"
                                 Margin="5">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="2"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Diagnostics Tab -->
            <TabItem Header="Diagnostics" x:Name="DiagnosticsTab" DataContext="{Binding Diagnostics}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Ping Test -->
                    <GroupBox Header="ICMP Ping Test" Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Hostname:" VerticalAlignment="Center" Width="80"/>
                                <TextBox Text="{Binding PingHostname, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="200" Margin="5,0"/>
                                <Button Content="Ping" 
                                        Command="{Binding RunPingCommand}" 
                                        Width="80" Height="25" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PingResult}" 
                                       Foreground="DarkBlue" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- TCP Connect Test -->
                    <GroupBox Header="TCP Connection Test" Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Hostname:" VerticalAlignment="Center" Width="80"/>
                                <TextBox Text="{Binding TcpHostname, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="150" Margin="5,0"/>
                                <TextBlock Text="Port:" VerticalAlignment="Center" Width="40" Margin="10,0,5,0"/>
                                <TextBox Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="60" Margin="0,0"/>
                                <Button Content="Test" 
                                        Command="{Binding RunTcpConnectCommand}" 
                                        Width="80" Height="25" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TcpResult}" 
                                       Foreground="DarkBlue" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>